; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="mod_card_game"
run/main_scene="uid://btge1np0rqr"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="uid://bxglnihr3dutv"

[autoload]

GApiManager="*uid://c7fo7l8vb43vc"
GNetManager="*uid://bf88iupd5nc0y"
GResourceManager="*uid://dcyaay1155a3a"
ToastX="*uid://bjgkmehoqtiqt"
PhantomCameraManager="*uid://duq6jhf6unyis"
TooltipManager="*uid://brqdjqtp7oci6"
TooltipPlaceholderVariables="*uid://nel5st3wktcw"
TooltipLinkData="*uid://bjkjmtptqed1y"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/Panel3D/plugin.cfg", "res://addons/lua-gdextension/plugin.cfg", "res://addons/material_icons_importer/plugin.cfg", "res://addons/no_clip_sprite3d/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/rpc-await/plugin.cfg", "res://addons/toastx/plugin.cfg", "res://addons/tooltips_pro/plugin.cfg")

